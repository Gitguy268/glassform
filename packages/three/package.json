{
  "name": "@glassform/three",
  "version": "0.1.0",
  "description": "Composite glassform liquid glass over Three.js scenes (WebGPURenderer or WebGLRenderer).",
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "webgl2",
    "liquid-glass"
  ],
  "homepage": "https://gitguy268.github.io/glassform/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitguy268/glassform.git",
    "directory": "packages/three"
  },
  "bugs": {
    "url": "https://github.com/Gitguy268/glassform/issues"
  },
  "author": "Lucas Van De Weerd",
  "contributors": [
    "Andras Prifer (liquid-dom)"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "@glassform/core": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.184"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "@webgpu/types": "^0.1.69",
    "three": "^0.184.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  }
}
