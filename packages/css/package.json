{
  "name": "@glassform/css",
  "version": "0.1.0",
  "description": "Liquid glass for ordinary page content: backdrop-filter, SVG refraction on Chromium, optional snapshot refraction everywhere.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/element.js", "**/element.cjs"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glassform/core": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.15"
  }
}
