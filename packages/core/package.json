{
  "name": "@glassform/core",
  "version": "0.1.0",
  "description": "Liquid glass renderer for the web: WebGPU and WebGL2 backends, scene graph, SwiftUI-style materials, DOM/media/snapshot content.",
  "keywords": [
    "webgpu",
    "webgl2",
    "glass",
    "liquid-glass",
    "glassmorphism",
    "refraction",
    "shader"
  ],
  "homepage": "https://gitguy268.github.io/glassform/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitguy268/glassform.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Gitguy268/glassform/issues"
  },
  "author": "Lucas Van De Weerd",
  "contributors": [
    "Andras Prifer (liquid-dom)"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "@glassform/layout": "workspace:*",
    "modern-screenshot": "4.7.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.15"
  }
}
