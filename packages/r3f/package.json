{
  "name": "@glassform/r3f",
  "version": "0.1.0",
  "description": "React Three Fiber bridge for glassform liquid glass (WebGLRenderer or WebGPURenderer).",
  "keywords": [
    "react-three-fiber",
    "r3f",
    "three",
    "liquid-glass"
  ],
  "homepage": "https://gitguy268.github.io/glassform/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitguy268/glassform.git",
    "directory": "packages/r3f"
  },
  "bugs": {
    "url": "https://github.com/Gitguy268/glassform/issues"
  },
  "author": "Lucas Van De Weerd",
  "contributors": [
    "Andras Prifer (liquid-dom)"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "@glassform/core": "workspace:*",
    "@glassform/react": "workspace:*",
    "@glassform/three": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19.0.0",
    "three": ">=0.184"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.14",
    "@types/three": "^0.184.0",
    "@webgpu/types": "^0.1.69",
    "react": "^19.2.4",
    "three": "^0.184.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  }
}
